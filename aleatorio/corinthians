labelSenha = QLabel("Senha:", tela1)
labelSenha.move(80, 85)
inputSenha = QLineEdit(tela1)
inputSenha.move(80, 100)
inputSenha.setEchoMode(QLineEdit.Password)

botaoLogin = QPushButton("Login", tela1)
botaoLogin.move(102, 140)
botaoLogin.clicked.connect(validarLogin)


telaPrincipal = abrirTelaPrincipal()

# criando stack de telas
stack = QStackedWidget()
stack.addWidget(tela1)
